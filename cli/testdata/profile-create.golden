$ moolah profile show mybank
name = "mybank"
description = "Created from statement.csv"

[detect]
headers = ["Booking date", "Text", "Debit", "Credit"]

[table]
stop = "Total"

[columns]
date = "Booking date"
date_format = "02/01/2006"
payee = "Text"
external_id = "Reference"
debit = "Debit"
credit = "Credit"
decimal_comma = true

